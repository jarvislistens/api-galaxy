{
  "$defs": {
    "Acceptance": {
      "enum": [
        "observed",
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ],
      "title": "Acceptance",
      "type": "string"
    },
    "Evidence": {
      "description": "A pointer back into the source material that justifies a node, edge or answer.",
      "properties": {
        "excerpt": {
          "default": "",
          "description": "Short, escaped quote from the source.",
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "pointer": {
          "description": "RFC 6901 JSON Pointer into the normalized spec.",
          "title": "Pointer",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_file",
        "pointer"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "Estate",
        "Domain",
        "Service",
        "Server",
        "APIOperation",
        "Endpoint",
        "Schema",
        "Field",
        "SecurityScheme",
        "BusinessEntity",
        "Capability",
        "Journey",
        "JourneyStep",
        "Risk",
        "Scenario",
        "Change",
        "Repair",
        "Evidence"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "Provenance": {
      "description": "Why this object exists and how much you should trust it.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "explanation": {
          "description": "Human-readable, one sentence, no jargon.",
          "title": "Explanation",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Pointer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "explanation"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceKind": {
      "description": "Where a fact came from. This is the fact-vs-inference boundary.",
      "enum": [
        "specification",
        "deterministic_rule",
        "bundled_analysis",
        "ai_inference",
        "user_edit",
        "scenario"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "properties": {
    "acceptance": {
      "$ref": "#/$defs/Acceptance",
      "default": "observed"
    },
    "attrs": {
      "additionalProperties": true,
      "title": "Attrs",
      "type": "object"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "type": {
      "$ref": "#/$defs/NodeType"
    }
  },
  "required": [
    "id",
    "type",
    "label",
    "project_id",
    "provenance"
  ],
  "title": "GraphNode",
  "type": "object"
}
