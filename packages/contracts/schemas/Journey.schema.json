{
  "$defs": {
    "Evidence": {
      "description": "A pointer back into the source material that justifies a node, edge or answer.",
      "properties": {
        "excerpt": {
          "default": "",
          "description": "Short, escaped quote from the source.",
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "pointer": {
          "description": "RFC 6901 JSON Pointer into the normalized spec.",
          "title": "Pointer",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_file",
        "pointer"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JourneyStep": {
      "properties": {
        "deprecated": {
          "default": false,
          "title": "Deprecated",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "narration": {
          "description": "Plain language, understandable by a non-engineer.",
          "title": "Narration",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "schema_ids": {
          "items": {
            "type": "string"
          },
          "title": "Schema Ids",
          "type": "array"
        },
        "service_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "technical_detail": {
          "default": "",
          "title": "Technical Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "order",
        "label",
        "narration"
      ],
      "title": "JourneyStep",
      "type": "object"
    },
    "Provenance": {
      "description": "Why this object exists and how much you should trust it.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "explanation": {
          "description": "Human-readable, one sentence, no jargon.",
          "title": "Explanation",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Pointer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "explanation"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceKind": {
      "description": "Where a fact came from. This is the fact-vs-inference boundary.",
      "enum": [
        "specification",
        "deterministic_rule",
        "bundled_analysis",
        "ai_inference",
        "user_edit",
        "scenario"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "domain_ids": {
      "items": {
        "type": "string"
      },
      "title": "Domain Ids",
      "type": "array"
    },
    "editable": {
      "default": true,
      "title": "Editable",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/JourneyStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "provenance"
  ],
  "title": "Journey",
  "type": "object"
}
