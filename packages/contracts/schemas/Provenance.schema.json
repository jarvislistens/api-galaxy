{
  "$defs": {
    "SourceKind": {
      "description": "Where a fact came from. This is the fact-vs-inference boundary.",
      "enum": [
        "specification",
        "deterministic_rule",
        "bundled_analysis",
        "ai_inference",
        "user_edit",
        "scenario"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "description": "Why this object exists and how much you should trust it.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "explanation": {
      "description": "Human-readable, one sentence, no jargon.",
      "title": "Explanation",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "prompt_template_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Template Version"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "rule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    },
    "source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source File"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_pointer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Pointer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "source_kind",
    "explanation"
  ],
  "title": "Provenance",
  "type": "object"
}
