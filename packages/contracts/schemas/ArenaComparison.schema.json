{
  "$defs": {
    "ArenaRelation": {
      "properties": {
        "confidences": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Confidences",
          "type": "object"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderKind"
          },
          "title": "Providers",
          "type": "array"
        },
        "rationales": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rationales",
          "type": "object"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "verdict": {
          "default": "consensus",
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "relation"
      ],
      "title": "ArenaRelation",
      "type": "object"
    },
    "ProviderKind": {
      "enum": [
        "deterministic",
        "ollama",
        "kimi"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ProviderRunMetrics": {
      "properties": {
        "aliases": {
          "default": 0,
          "title": "Aliases",
          "type": "integer"
        },
        "domains": {
          "default": 0,
          "title": "Domains",
          "type": "integer"
        },
        "entities": {
          "default": 0,
          "title": "Entities",
          "type": "integer"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "hallucinated_references": {
          "default": 0,
          "title": "Hallucinated References",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "default": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "relations": {
          "default": 0,
          "title": "Relations",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "risks": {
          "default": 0,
          "title": "Risks",
          "type": "integer"
        },
        "valid_structured_output": {
          "default": true,
          "title": "Valid Structured Output",
          "type": "boolean"
        }
      },
      "required": [
        "provider"
      ],
      "title": "ProviderRunMetrics",
      "type": "object"
    },
    "TaskKind": {
      "enum": [
        "enrich",
        "answer",
        "repair",
        "narrate"
      ],
      "title": "TaskKind",
      "type": "string"
    }
  },
  "properties": {
    "alias_agreement": {
      "additionalProperties": true,
      "title": "Alias Agreement",
      "type": "object"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/ArenaRelation"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "consensus": {
      "items": {
        "$ref": "#/$defs/ArenaRelation"
      },
      "title": "Consensus",
      "type": "array"
    },
    "domain_agreement": {
      "additionalProperties": true,
      "title": "Domain Agreement",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/ProviderRunMetrics"
      },
      "title": "Metrics",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "only_a": {
      "items": {
        "$ref": "#/$defs/ArenaRelation"
      },
      "title": "Only A",
      "type": "array"
    },
    "only_b": {
      "items": {
        "$ref": "#/$defs/ArenaRelation"
      },
      "title": "Only B",
      "type": "array"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskKind",
      "default": "enrich"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "ArenaComparison",
  "type": "object"
}
