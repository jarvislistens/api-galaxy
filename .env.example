# API Galaxy configuration.
#
# Copy to `.env` and edit. Every value has a working default, so an empty file is fine —
# the app runs offline with no model and no key.
#
# NEVER commit a real API key. `.env` is in .gitignore for that reason.

# --- server -------------------------------------------------------------------
API_GALAXY_HOST=127.0.0.1
API_GALAXY_PORT=8099
API_GALAXY_LOG_LEVEL=info

# Where projects, graphs, exports and the SQLite database live.
# Defaults to ~/.api-galaxy
# API_GALAXY_DATA_DIR=/absolute/path/to/data

# --- local model (default provider) --------------------------------------------
# Install Ollama from https://ollama.com, then: ollama pull qwen3:4b
API_GALAXY_OLLAMA_BASE_URL=http://127.0.0.1:11434
API_GALAXY_OLLAMA_MODEL=qwen3:4b
API_GALAXY_OLLAMA_TIMEOUT=180

# --- external model (optional, off unless you add a key) -----------------------
# Master switch. Set to false and nothing can leave this machine, whatever else is set.
API_GALAXY_EXTERNAL_PROVIDERS_ENABLED=true
API_GALAXY_KIMI_BASE_URL=https://api.moonshot.ai/v1
API_GALAXY_KIMI_MODEL=kimi-k2-0905-preview
API_GALAXY_KIMI_TIMEOUT=120
# Prefer entering the key in Settings — it goes to your OS keychain there instead of a file.
# API_GALAXY_KIMI_API_KEY=

# --- limits and safety ---------------------------------------------------------
API_GALAXY_MAX_UPLOAD_BYTES=12582912
API_GALAXY_MAX_PROJECTS=50
API_GALAXY_REQUEST_RATE_LIMIT_PER_MINUTE=120

# Remote $ref fetching is off by default. Turning it on lets a specification pull
# content from the internet at parse time.
API_GALAXY_ALLOW_REMOTE_REFS=false

# SSRF guard for URL imports. Leave false unless you understand the consequence:
# a URL that resolves to a private address could be used to probe your own network.
API_GALAXY_ALLOW_PRIVATE_NETWORK_URLS=false

# --- web app -------------------------------------------------------------------
# Where the browser-side proxy forwards /api/* requests.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8099
